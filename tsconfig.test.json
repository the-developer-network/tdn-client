{
    "extends": "./tsconfig.app.json",
    "compilerOptions": {
        "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom"],
        "noUnusedLocals": false,
        "noUnusedParameters": false
    },
    "include": [
        "src/**/*.test.ts",
        "src/**/*.test.tsx",
        "src/**/*.spec.ts",
        "src/**/*.spec.tsx",
        "tests"
    ]
}
